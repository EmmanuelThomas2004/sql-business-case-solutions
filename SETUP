CREATE TABLE EmployeeSales (
    SaleID INT PRIMARY KEY,
    EmployeeID INT,
    EmployeeName VARCHAR(100),
    SaleDate DATE,
    ProductName VARCHAR(100),
    Quantity INT,
    UnitPrice DECIMAL(10,2),
    Discount DECIMAL(5,2)
);

INSERT INTO EmployeeSales (SaleID, EmployeeID, EmployeeName, SaleDate, ProductName, Quantity, UnitPrice, Discount) VALUES
