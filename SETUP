SELECT EmployeeName,
       SUM(Quantity * UnitPrice * (1 - Discount)) AS TotalSales
FROM EmployeeSales
GROUP BY EmployeeName
HAVING SUM(Quantity * UnitPrice * (1 - Discount)) > 150000;
